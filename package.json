{
  "name": "personal-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Personal Workspace - Notes, News, Todo & Alarm System",
  "author": "Huy Quoc",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app": "electron electron/main.cjs",
    "app:dev": "concurrently \"vite\" \"electron electron/main.cjs\"",
    "build:exe": "npm run build && electron-packager . \"Personal Workspace\" --platform=win32 --arch=x64 --out=release --overwrite"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
